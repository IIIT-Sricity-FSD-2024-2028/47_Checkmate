# Server
PORT=3000
NODE_ENV=development

# CORS allowlist (comma-separated). `null` is the literal 4-char string sent as
# the Origin by pages opened via file:// — omitting it silently breaks them.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:5501,null

# Logging (winston-daily-rotate-file)
LOG_DIR=logs
LOG_LEVEL=info
LOG_DATE_PATTERN=YYYY-MM-DD
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d

# File upload
UPLOAD_MAX_BYTES=5242880

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=20
RATE_LIMIT_SIGNUP_MAX=5
